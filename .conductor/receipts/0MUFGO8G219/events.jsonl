{"seq":17,"at":"2026-09-24T11:48:23.25876473Z","source":"observed","stage":"tests","what":"Bash cat > /tmp/probe_test.rs <<'EOF'\nuse conductor_engine::metrics::{collect, merge, total};\nuse conductor_engine::trace::build;\nuse conductor_model::Event;\n\nfn fixture() -> Vec<Event> {\n    include_str!(\"../../../docs/examples/live-run-durations/events.jsonl\")\n        .lines()\n        .map(|l| serde_json::from_str(l).unwrap())\n        .collect()\n}\n\n#[test]\nfn probe() {\n    let e = fixture();\n    let m1 = collect(&build(\"R1\", &e), &e);\n    let tokens = total(&m1, \"conductor.tokens\", &[]);\n    let cost = total(&m1, \"conductor.cost\", &[]);\n    let attempts_passed = total(&m1, \"conductor.attempts\", &[(\"outcome\",\"passed\")]);\n    let attempts_checkfailed = total(&m1, \"conductor.attempts\", &[(\"outcome\",\"check_failed\")]);\n    let catches = total(&m1, \"conductor.catches\", &[]);\n    println!(\"PROBE tokens={tokens} cost={cost} passed={attempts_passed} checkfailed={attempts_checkfailed} catches={catches}\");\n\n    let mut all = m1.clone();\n    let m2 = collect(&build(\"R2\", &e), &e);\n    merge(&mut all, m2);\n    let tokens2 = total(&all, \"conductor.tokens\", &[]);\n    let cost2 = total(&all, \"conductor.cost\", &[]);\n    println!(\"PROBE2 tokens={tokens2} cost={cost2}\");\n}\nEOF\ncp /tmp/probe_test.rs crates/conductor-engine/tests/zz_probe.rs\ncargo test -p conductor-engine --test zz_probe -- --nocapture 2>&1 | tail -30","prev":"sha256:ae6b1a220837ab264f193e20c7061b00269c931ae0a20e73e02dcc43ac44f8a3","hash":"sha256:c5fbfab208487cc15ec528b278bd3635948639132f070081d703ac7cb69a7664"}
